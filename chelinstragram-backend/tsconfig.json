{
  "compilerOptions": {
    /* Estándar y Resolución Moderna */
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    /* Bibliotecas */
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    /* Configuración de Emisión */
    "outDir": "./dist",
    /* No definimos rootDir ni baseUrl para evitar conflictos de jerarquía */
    /* Rigor de Tipado */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    /* Interoperabilidad */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    /* Decoradores */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}